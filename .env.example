# Environment
ENVIRONMENT=development
PROJECT_NAME="Backend Deus Conhece o Seu Nome"
API_V1_STR=/api/v1
SECRET_KEY=change-this-super-secret-key-in-production-min-32-chars-long!
ADMIN_API_KEY=dev-admin-api-key-secret

# PostgreSQL Database
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=app
POSTGRES_PASSWORD=password
POSTGRES_DB=deus_conhece_nome
DATABASE_URL=postgresql+psycopg://app:password@localhost:5432/deus_conhece_nome

# Storage
STORAGE_PATH=./storage/books
DOWNLOAD_URL_BASE=http://localhost:8000/api/v1/books

# Evolution API (WhatsApp)
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=your-evolution-global-or-instance-api-key
EVOLUTION_INSTANCE=deus-conhece-nome

# Webhook Secrets
ORDER_WEBHOOK_SECRET=your-orders-webhook-secret
EVOLUTION_WEBHOOK_SECRET=your-evolution-webhook-secret
CAKTO_WEBHOOK_SECRET=your-cakto-webhook-secret
CAKTO_PRODUCT_ID=d4c39c54-735b-416f-bbdf-47752679b492
